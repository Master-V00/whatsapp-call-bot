# رقم البوت نفسه اللي هيتربط (بدون + أو مسافات) - مثال لرقم مصري:
PHONE_NUMBER=2010xxxxxxxx

# كود الربط المخصص (8 حروف/أرقام كابيتال) - بيتجدد تلقائيا كل ~35 ثانية لحد ما تربط
PAIRING_CODE=MASTERVO

# ملف الصوت اللي هيشتغل في المكالمة (جنب index.js)
AUDIO_FILE=./audio.mp3

# مدة مكالمة "رن عليا" (وقت التحدث بعد الرد — تُضاف عليها مهلة الرن تلقائيًا)
CALL_DURATION_MS=30000

# مهلة الرد على المكالمة: لو رديت متأخر (حتى ~60 ثانية) المكالمة مش هتقفل والصوت هيشتغل
RING_BUDGET_MS=60000

# هل يعيد تشغيل المقطع لحد ما المدة تخلص؟ true / false
REPEAT_AUDIO=true

# كلمات التريجر اللي لو اتبعتت البوت يرن عليك (افصل بفاصلة)
TRIGGER_WORDS=رن عليا,call me,call,اتصل,اتصل بيا,رن

# مستوى اللوج: info / silent
LOG_LEVEL=info

# ---------- الصوت من النص: ElevenLabs (افتراضي) ثم gTTS (احتياطي) ----------
# هات المفتاح من: https://elevenlabs.io (مجاني 10k حرف/شهر)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2
# eleven = الأساسي ثم gTTS عند أي خطأ | gtts = تخطي ElevenLabs
TTS_ENGINE=eleven
PYTHON_CMD=python
TTS_LANG=ar
TTS_MAX_CHARS=500

# ---------- الأذان والتذكيرات ----------
ADHAN_FILE=./adhan.mp3
